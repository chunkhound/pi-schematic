{
  "entry": [
    // pi loads the extension through package.json `pi.extensions`.
    "index.ts",
    // Started by path: the e2e harnesses spawn these, CI imports the coverage script,
    // register-loader.mjs registers the test loader, and tsc type-checks the typecheck files.
    "tests/e2e/test-host.ts",
    "tests/e2e/real-host-probe.ts",
    "tests/e2e/real-host-child-probe.ts",
    "scripts/coverage-comment.mjs",
    "test-loader.mjs",
    "tests/typecheck/*.ts",
    // TypeScript reads it for the types of pi-packages.mjs.
    "pi-packages.d.mts"
  ],
  // Platform sandbox binaries that os-sandbox.ts runs when the host has them.
  "ignoreBinaries": ["bwrap", "sandbox-exec"],
  // No file imports it. The exact devDependency pins the copy that pi-coding-agent pulls in
  // with a caret range, so the lockfile keeps it on the pinned Pi version.
  "ignoreDependencies": ["@earendil-works/pi-agent-core"]
}
