{
  "name": "pi-schematic",
  "version": "0.6.0",
  "type": "module",
  "description": "Context management primitives for the pi coding agent — spawn, notebook, handoff",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chunkhound/pi-schematic.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.2",
    "@earendil-works/pi-coding-agent": ">=0.99.2",
    "@earendil-works/pi-tui": ">=0.99.2",
    "typebox": ">=1.3.27"
  },
  "scripts": {
    "prepare": "husky",
    "test": "node ./scripts/run-node-test.mjs tests/unit/**/*.test.ts",
    "test:coverage": "node --import ./register-loader.mjs --experimental-test-coverage --test-coverage-include='readonly-*.ts' --test-coverage-include='temp-dir.ts' --test-coverage-include='resolve-path.ts' --test-coverage-exclude='**/node_modules/**' --test-coverage-lines=90 --test-coverage-branches=85 --test 'tests/unit/readonly-*.test.ts' tests/unit/temp-dir.test.ts tests/unit/resolve-path.test.ts",
    "test:e2e": "node ./scripts/run-node-test.mjs tests/e2e/**/*.test.ts",
    "test:all": "npm run test && npm run test:e2e",
    "test:snapshots:check": "node ./scripts/run-node-test.mjs tests/unit/render-snapshots.test.ts",
    "test:snapshots:update": "node ./scripts/run-node-test.mjs --update-snapshots tests/unit/render-snapshots.test.ts",
    "test:compat:current": "node ./scripts/test-compat-current.mjs",
    "test:package-host": "node ./scripts/test-package-host.mjs",
    "typecheck": "node ./scripts/dependency-graph-assertions.mjs && tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@types/node": "^25.9.3",
    "audit-ci": "^7.1.0",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "typebox": "1.3.27",
    "typescript": "^6.0.3"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/chunkhound/pi-schematic/main/assets/logo-animated.gif",
    "extensions": [
      "./index.ts"
    ]
  }
}
