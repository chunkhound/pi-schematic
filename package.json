{
  "name": "@chunkhound/pi-schematic",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.7.1",
  "type": "module",
  "description": "Context management primitives for the pi coding agent — spawn, notebook, handoff",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chunkhound/pi-schematic.git"
  },
  "homepage": "https://github.com/chunkhound/pi-schematic#readme",
  "bugs": "https://github.com/chunkhound/pi-schematic/issues",
  "author": {
    "name": "ChunkHound",
    "url": "https://github.com/chunkhound"
  },
  "files": [
    "/*.ts",
    "!/vitest.config.ts",
    "handoff/",
    "model-groups/",
    "notebook/",
    "spawn/",
    "time/",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.2.0",
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "@earendil-works/pi-tui": ">=1.2.0",
    "typebox": ">=1.3.27"
  },
  "scripts": {
    "prepare": "husky",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "vitest run --project e2e",
    "test:all": "npm run test && npm run test:e2e",
    "test:snapshots:check": "vitest run --project unit --update=none tests/unit/render-snapshots.test.ts",
    "test:snapshots:update": "vitest run --project unit --update=all tests/unit/render-snapshots.test.ts",
    "test:compat:current": "node ./scripts/test-compat-current.mjs",
    "test:package-host": "node ./scripts/test-package-host.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "audit-ci": "^7.1.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-n": "^18.5.0",
    "fast-check": "^4.8.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "typebox": "1.3.27",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/chunkhound/pi-schematic/main/assets/logo-animated.gif",
    "extensions": [
      "./index.ts"
    ]
  }
}
